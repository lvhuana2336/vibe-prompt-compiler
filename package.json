{
  "name": "yan-gou-vibe-prompt-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把自然语言需求编译成可执行 vibecoding 提示词的 Windows 桌面应用",
  "author": "YanGou",
  "license": "MIT",
  "keywords": [
    "vibecoding",
    "prompt-engineering",
    "ai-coding",
    "electron",
    "react",
    "codex",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvhuana2336/vibe-prompt-compiler.git"
  },
  "homepage": "https://github.com/lvhuana2336/vibe-prompt-compiler#readme",
  "bugs": {
    "url": "https://github.com/lvhuana2336/vibe-prompt-compiler/issues"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "desktop:smoke": "electron . --smoke-test",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "icon": "node scripts/make-icon.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "express": "4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "vite": "^6.0.5"
  }
}
